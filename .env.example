# Railway Configuration
# For local development: Fill these values manually
# For Railway deployment: These will be auto-configured when linking services

# MySQL Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=sapposstore

# Backend Server Port
PORT=4000

# Frontend URL (for CORS and proxy)
VITE_API_URL=http://localhost:4000
